{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screenshot-guru-11436.web.app/project.schema.json",
  "title": "screenshot-guru project",
  "description": "project.json inside a screenshot-guru project zip. Decks are keyed by device id and use either the short recipe format or the full layer format.",
  "x-max-slides": {
    "iphone": 10,
    "ipad": 10,
    "iphone-duo-outer": 10,
    "iphone-duo-inner": 10,
    "apple-watch": 10,
    "mac": 10,
    "apple-tv": 10,
    "vision-pro": 10,
    "android-phone": 8,
    "android-tablet-7": 8,
    "android-tablet-10": 8,
    "chromebook": 8,
    "wear-os": 8,
    "android-tv": 8,
    "android-tv-banner": 1,
    "android-xr": 8,
    "feature-graphic": 1,
    "event-card": 10,
    "event-details": 10,
    "play-promo": 10,
    "promo-vertical": 10,
    "appstore-search": 1
  },
  "type": "object",
  "required": [
    "schema",
    "decks"
  ],
  "properties": {
    "schema": {
      "const": "screenshot-guru/1"
    },
    "name": {
      "type": "string"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "activeLocale": {
      "type": "string"
    },
    "activeDevice": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "fonts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "decks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "iphone",
          "ipad",
          "iphone-duo-outer",
          "iphone-duo-inner",
          "apple-watch",
          "mac",
          "apple-tv",
          "vision-pro",
          "android-phone",
          "android-tablet-7",
          "android-tablet-10",
          "chromebook",
          "wear-os",
          "android-tv",
          "android-tv-banner",
          "android-xr",
          "feature-graphic",
          "event-card",
          "event-details",
          "play-promo",
          "promo-vertical",
          "appstore-search"
        ]
      },
      "additionalProperties": {
        "if": {
          "type": "object",
          "required": [
            "slides"
          ],
          "properties": {
            "slides": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "layers"
                ]
              }
            }
          }
        },
        "then": {
          "$ref": "#/$defs/fullDeck"
        },
        "else": {
          "$ref": "#/$defs/recipeDeck"
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "paint": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "solid",
            "linear",
            "radial"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "solid"
              }
            }
          },
          "then": {
            "required": [
              "color"
            ],
            "properties": {
              "color": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "linear"
              }
            }
          },
          "then": {
            "required": [
              "angle",
              "stops"
            ],
            "properties": {
              "angle": {
                "type": "number"
              },
              "stops": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "offset",
                    "color"
                  ],
                  "properties": {
                    "offset": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "color": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "radial"
              }
            }
          },
          "then": {
            "required": [
              "cx",
              "cy",
              "r",
              "stops"
            ],
            "properties": {
              "cx": {
                "type": "number"
              },
              "cy": {
                "type": "number"
              },
              "r": {
                "type": "number"
              },
              "stops": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "offset",
                    "color"
                  ],
                  "properties": {
                    "offset": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "color": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "background": {
      "type": "object",
      "required": [
        "paint"
      ],
      "properties": {
        "paint": {
          "$ref": "#/$defs/paint"
        },
        "orbs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "r",
              "color",
              "opacity"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "r": {
                "type": "number"
              },
              "color": {
                "type": "string",
                "minLength": 1
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "pattern": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "none",
                "dots",
                "grid",
                "lines",
                "waves"
              ]
            },
            "color": {
              "type": "string",
              "minLength": 1
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "size": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "noise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vignette": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "recipeSlide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "enum": [
            "hero",
            "top",
            "duo",
            "claim",
            "span",
            "side",
            "full",
            "icon"
          ]
        },
        "label": {
          "$ref": "#/$defs/localized"
        },
        "headline": {
          "$ref": "#/$defs/localized"
        },
        "subline": {
          "$ref": "#/$defs/localized"
        },
        "screenshot": {
          "$ref": "#/$defs/localized"
        },
        "screenshot2": {
          "$ref": "#/$defs/localized"
        },
        "background": {
          "$ref": "#/$defs/background"
        }
      }
    },
    "recipeDeck": {
      "type": "object",
      "required": [
        "template",
        "slides"
      ],
      "additionalProperties": false,
      "properties": {
        "template": {
          "enum": [
            "clean-light",
            "midnight-glow",
            "vivid-gradient",
            "pastel-dream",
            "swiss-bold",
            "aurora-glass",
            "neon-night",
            "paper-japandi",
            "candy-pop",
            "ocean-tilt",
            "panorama",
            "editorial-serif"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accent": {
              "type": "string",
              "minLength": 1
            },
            "textColor": {
              "type": "string",
              "minLength": 1
            },
            "frameColor": {
              "type": "string",
              "minLength": 1
            },
            "font": {
              "type": "string"
            },
            "background": {
              "$ref": "#/$defs/background"
            }
          }
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/recipeSlide"
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "type",
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "image",
            "device",
            "shape"
          ]
        },
        "id": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "text": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "asset": {
          "type": "string"
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "frame": {
          "enum": [
            "phone",
            "phone-android",
            "tablet",
            "watch",
            "watch-round",
            "laptop",
            "tv",
            "browser",
            "none"
          ]
        },
        "shape": {
          "enum": [
            "rect",
            "ellipse",
            "star",
            "blob"
          ]
        },
        "fill": {
          "$ref": "#/$defs/paint"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text",
              "font",
              "weight",
              "size",
              "fill"
            ]
          }
        }
      ]
    },
    "fullDeck": {
      "type": "object",
      "required": [
        "background",
        "slides"
      ],
      "properties": {
        "device": {
          "type": "string"
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "background": {
          "$ref": "#/$defs/background"
        },
        "spanBackground": {
          "type": "boolean"
        },
        "template": {
          "type": "string"
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "layers"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "background": {
                "$ref": "#/$defs/background"
              },
              "layers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/layer"
                }
              }
            }
          }
        }
      }
    }
  }
}
