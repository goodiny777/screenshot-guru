{
  "name": "screenshot-guru",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-skill.mjs && tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "skill": "node scripts/build-skill.mjs",
    "deploy": "npm run build && firebase deploy --only hosting",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node tests/fixtures/make-fixtures.mjs",
    "check:skips": "node scripts/check-skips.mjs",
    "check:skill": "node scripts/check-skill-fresh.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:skips && npm run check:skill && npm test"
  },
  "dependencies": {
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "pngjs": "^7.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  }
}
